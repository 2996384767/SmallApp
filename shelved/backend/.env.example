# Development defaults. Copy this file to .env only when you need overrides.
FLASK_DEBUG=1
SECRET_KEY=replace-this-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Without DATABASE_URL, development uses instance/aaa_dev.db (SQLite).
# MariaDB example:
# DATABASE_URL=mysql+pymysql://aaa_user:your_password@127.0.0.1:3306/aaa_small_app?charset=utf8mb4
